{
  "appId": "org.adra.dms",
  "appName": "ADRA",
  "webDir": "dist",
  "server": {
    "url": "https://adra-f9vi.vercel.app",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#020617",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#004D3F"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}
